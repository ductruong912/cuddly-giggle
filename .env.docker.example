# Optional overrides for `docker compose`. Copy to `.env` (same folder as
# docker-compose.yml) only if you need to change a default — the stack runs without it.
#
#   cp .env.docker.example .env

# --- GPU layers offloaded to VRAM for the llama recognition server ---
# 20 suits a 6 GB card. Lower it if llama OOMs; raise it on a bigger GPU.
LLAMA_N_GPU_LAYERS=20
LLAMA_CTX_SIZE=4096

# --- CUDA build of the app image ---
# Defaults target CUDA 12.6 (driver >= 555 Linux / >= 560 Windows-WSL2).
# For an older driver capped at CUDA 11.8, switch BOTH lines together:
# CUDA_TAG=11.8.0-cudnn8-runtime-ubuntu22.04
# PADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu118/
CUDA_TAG=12.6.3-cudnn-runtime-ubuntu22.04
PADDLE_INDEX=https://www.paddlepaddle.org.cn/packages/stable/cu126/
