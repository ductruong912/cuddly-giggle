# Server
HOST=127.0.0.1
PORT=8000

# OCR engine selection
OCR_PRIMARY_ENGINE=paddleocr_vl
OCR_FALLBACK_ENGINE=pp_structure_v3
DEFAULT_ENABLE_FALLBACK=false

# PaddleOCR runtime
# Use gpu:0 for first CUDA GPU, cpu for CPU, or leave empty for PaddleOCR default.
OCR_DEVICE=gpu:0
OCR_INFERENCE_ENGINE=

# PaddleOCR-VL pipeline
# Default project target is PaddleOCR-VL 1.6. Set empty to let PaddleOCR choose its package default.
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
WARMUP_MODELS_ON_STARTUP=true
PADDLEOCR_VL_USE_GGUF=false

# Advanced GGUF backend overrides. When PADDLEOCR_VL_USE_GGUF=false these are ignored.
#PADDLEOCR_VL_REC_BACKEND=llama-cpp-server
#PADDLEOCR_VL_REC_SERVER_URL=http://127.0.0.1:8080/v1
#PADDLEOCR_VL_REC_MAX_CONCURRENCY=1
#PADDLEOCR_VL_REC_API_MODEL_NAME=paddleocr-vl
#PADDLEOCR_VL_REC_API_KEY=

# GGUF artifacts. When PADDLEOCR_VL_USE_GGUF=true, main.py downloads missing
# files automatically. You can also pre-download with: python scripts/setup_llama_cpp.py
LLAMA_CPP_DIR=llama
LLAMA_CPP_MODELS_DIR=models
# Empty means resolve the latest matching asset from GitHub Releases.
LLAMA_CPP_RELEASE_URL=
# Windows options commonly used here: win-cuda-cu13.3-x64, win-cuda-cu12.4-x64, win-x64.
LLAMA_CPP_RELEASE_FLAVOR=win-cuda-cu13.3-x64

# llama.cpp server autostart. Used only when PADDLEOCR_VL_USE_GGUF=true.
LLAMA_SERVER_AUTOSTART=true
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_CTX_SIZE=4096
LLAMA_SERVER_PARALLEL=1
LLAMA_SERVER_N_GPU_LAYERS=40
LLAMA_SERVER_MMPROJ_OFFLOAD=true
LLAMA_SERVER_FLASH_ATTN=on
LLAMA_SERVER_THREADS=4
LLAMA_SERVER_THREADS_BATCH=4
LLAMA_SERVER_TEMP=0
LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=120

# Local folders
DOC_TEMP_DIR=.tmp_doc_parse
PARSE_OUTPUT_DIR=outputs_test
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# Optional tuning. Leave these unset/commented to use the built-in defaults
# in app/core/config.py; uncomment a line only to override a specific value.

# Decision thresholds (pass / borderline / quality-fail):
#CONFIDENCE_PASS_THRESHOLD=0.84
#CONFIDENCE_BORDERLINE_THRESHOLD=0.68
#QUALITY_FAIL_THRESHOLD=0.62

# Merge: how much higher the fallback page confidence must be to override the primary page.
#MERGE_FALLBACK_CONFIDENCE_MARGIN=0.08

# Image quality detection (image inputs only; PDFs and Word files use a neutral score of 0.9).
# Detection thresholds:
#QUALITY_BLUR_VAR_THRESHOLD=110.0
#QUALITY_DARK_MEAN_THRESHOLD=55.0
#QUALITY_BRIGHT_MEAN_THRESHOLD=220.0
#QUALITY_LOW_CONTRAST_STD_THRESHOLD=24.0
#QUALITY_SKEW_DEG_THRESHOLD=3.0
#QUALITY_MIN_RESOLUTION_PX=1200
#QUALITY_SCREEN_PHOTO_BORDER_DIFF=30.0
# Penalties subtracted from the 1.0 quality score per detected flag:
#QUALITY_PENALTY_SKEW=0.14
#QUALITY_PENALTY_BLUR=0.20
#QUALITY_PENALTY_ILLUMINATION=0.14
#QUALITY_PENALTY_SCREEN_PHOTO=0.18
#QUALITY_PENALTY_LOW_RESOLUTION=0.10
# Quality detector internals (the PDF/unreadable scores straddle QUALITY_FAIL_THRESHOLD):
#QUALITY_PDF_DEFAULT_SCORE=0.9
#QUALITY_UNREADABLE_IMAGE_SCORE=0.6
#QUALITY_CANNY_THRESHOLD1=50
#QUALITY_CANNY_THRESHOLD2=150
#QUALITY_HOUGH_THRESHOLD=180
#QUALITY_SKEW_MAX_LINES=80
#QUALITY_SCREEN_PHOTO_BORDER_FRACTION=0.03

# Fast text-layer parsing for digital PDFs. If useful text is not found, the
# service falls back to the normal OCR pipeline.
#PDF_TEXT_PARSE_ENABLED=true
#PDF_TEXT_MIN_TOTAL_CHARS=80
#PDF_TEXT_MIN_CHARS_PER_TEXT_PAGE=40
#PDF_TEXT_MIN_TEXT_PAGES_RATIO=1.0
#PDF_TEXT_CONFIDENCE=0.98

# Fast native parsing for Word files. DOCX is parsed directly; legacy DOC needs LibreOffice/soffice.
#WORD_TEXT_CONFIDENCE=0.99

# Fast native parsing for Excel files. XLSX/XLSM are parsed directly; legacy XLS needs LibreOffice/soffice.
#EXCEL_TEXT_CONFIDENCE=0.99

# Synthetic page-confidence heuristic (used only when an engine returns no score):
#NORMALIZER_CONFIDENCE_BASE=0.55
#NORMALIZER_CONFIDENCE_CONTENT_WEIGHT=0.35
#NORMALIZER_CONFIDENCE_TABLE_BONUS=0.05
#NORMALIZER_CONFIDENCE_CAP=0.9

# Optional Qwen verifier
QWEN_VERIFIER_ENABLED=false
QWEN_VERIFIER_BASE_URL=
QWEN_VERIFIER_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_VERIFIER_API_KEY=
# Optional verifier HTTP tuning (unset = built-in defaults):
#QWEN_VERIFIER_TIMEOUT_SECONDS=60.0
#QWEN_VERIFIER_CHAT_PATH=/v1/chat/completions

# Third-party logging/runtime defaults
QUIET_THIRD_PARTY_LOGS=true
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false
GLOG_minloglevel=2
GLOG_logtostderr=1
