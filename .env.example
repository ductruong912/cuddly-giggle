# ==============================================================================
# 1. SERVER CONFIGURATION
# ==============================================================================
HOST=127.0.0.1
PORT=8000
FRONTEND_DIST_DIR=frontend/dist
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_EXTRACT=10/minute

# ==============================================================================
# 2. OPENAI STRUCTURED EXTRACTION (/v1/extract/local)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=medium
# Validation retries; 0 disables self-healing.
LLM_SELF_HEAL_MAX_RETRIES=2
# Relative tolerance for quantity x unit_price vs. line total (0.01 = 1%).
PO_LINE_TOTAL_TOLERANCE_RATIO=0.01

# ==============================================================================
# 3. CONCURRENCY & REQUEST LIMITS
# ==============================================================================
OCR_MAX_CONCURRENCY=2
LLM_MAX_CONCURRENCY=8
STAGE_QUEUE_TIMEOUT_SECONDS=30
# 0 = automatic worker-thread count.
SERVER_THREAD_POOL_SIZE=0
OCR_EXECUTION_TIMEOUT_SECONDS=300
LLM_EXECUTION_TIMEOUT_SECONDS=180
IO_EXECUTION_TIMEOUT_SECONDS=60
# Upload limit in bytes (52428800 = 50 MiB).
MAX_UPLOAD_BYTES=52428800
PDF_MAX_PAGES=100

# ==============================================================================
# 4. EXTRACTION HISTORY (PostgreSQL)
# ==============================================================================
# Empty URL = files only.
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_MIGRATE_ON_STARTUP=true
# true = fail the request if saving to the database fails.
DATABASE_PERSISTENCE_REQUIRED=true

# ==============================================================================
# 5. OCR ENGINE & RUNTIME
# ==============================================================================
# The API and --auto model setup select GPU VL or CPU fast OCR from hardware.
OCR_DEVICE=gpu:0
WARMUP_MODELS_ON_STARTUP=false

# ==============================================================================
# 6. PADDLEOCR-VL & GGUF BACKEND
# ==============================================================================
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
PADDLEOCR_VL_USE_GGUF=true
PADDLEOCR_VL_REC_BACKEND=llama-cpp-server
PADDLEOCR_VL_REC_SERVER_URL=http://127.0.0.1:8080/v1
PADDLEOCR_VL_REC_MAX_CONCURRENCY=1
PADDLEOCR_VL_REC_API_MODEL_NAME=paddleocr-vl
# Correct whole-page rotation independently of unwarping.
PADDLEOCR_VL_AUTO_ROTATE=true
# Flatten curved pages. Keep off for flat scans to avoid distorting tables.
PADDLEOCR_VL_USE_DOC_UNWARPING=false

# ==============================================================================
# 7. LOCAL CPU OCR (/v1/extract/local)
# ==============================================================================
FAST_OCR_DEVICE=cpu
FAST_OCR_DETECTION_MODEL_NAME=PP-OCRv6_medium_det
FAST_OCR_RECOGNITION_MODEL_NAME=PP-OCRv6_small_rec
FAST_OCR_RECOGNITION_BATCH_SIZE=8
FAST_OCR_CPU_THREADS=4
FAST_OCR_INFERENCE_ENGINE=onnxruntime
FAST_OCR_ENABLE_MKLDNN=false
# Correct whole-page rotation.
FAST_OCR_AUTO_ROTATE=true

# ==============================================================================
# 8. LLAMA.CPP PATHS & SERVER
# ==============================================================================
LLAMA_CPP_DIR=llama
LLAMA_CPP_MODELS_DIR=models
LLAMA_SERVER_AUTOSTART=true
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_CTX_SIZE=4096
LLAMA_SERVER_PARALLEL=1
LLAMA_SERVER_N_GPU_LAYERS=20
LLAMA_SERVER_MMPROJ_OFFLOAD=true
LLAMA_SERVER_FLASH_ATTN=on
LLAMA_SERVER_THREADS=4
LLAMA_SERVER_THREADS_BATCH=4
LLAMA_SERVER_TEMP=0
LLAMA_SERVER_LOG_VERBOSITY=1

# Hide HTTPX/httpcore request chatter and successful static/health access logs.
# Warnings, errors and document API access logs remain visible.
QUIET_THIRD_PARTY_LOGS=true

# ==============================================================================
# 9. PDF PARSING & OUTPUT
# ==============================================================================
PDF_TEXT_PARSE_ENABLED=true
PDF_RASTERIZE_ENABLED=true
PDF_RASTERIZE_DPI=200
TABLE_ONLY_OUTPUT=false

# ==============================================================================
# 10. SCAN PREPROCESSING
# ==============================================================================
# Enable the pipeline, then individual steps.
PREPROCESS_ENABLED=false
# Apply EXIF orientation from phone photos.
PREPROCESS_EXIF_TRANSPOSE=false
# Crop dark scanner borders.
PREPROCESS_BORDER_CROP=false
# Correct small tilt; use OCR auto-rotation for quarter turns.
PREPROCESS_DESKEW=false
PREPROCESS_DESKEW_MIN_DEGREES=0.2
PREPROCESS_DESKEW_MAX_DEGREES=10.0
# Correct uneven lighting and shadows.
PREPROCESS_ILLUMINATION=false
# Remove speckle; kernel must be odd and at least 3.
PREPROCESS_DENOISE=false
PREPROCESS_DENOISE_KERNEL=3
# Improve local contrast on faded scans.
PREPROCESS_CLAHE=false
PREPROCESS_CLAHE_CLIP_LIMIT=2.0
# Save debug images; these files are not automatically cleaned up.
PREPROCESS_SAVE_IMAGES=false
PREPROCESS_DEBUG_DIR=outputs/preprocess

# ==============================================================================
# 11. OUTPUT STORAGE
# ==============================================================================
PARSE_OUTPUT_DIR=outputs/Test
# 0 = keep outputs indefinitely.
PARSE_OUTPUT_RETENTION_DAYS=14
PARSE_OUTPUT_SWEEP_MINUTES=60

# ==============================================================================
# 12. PADDLEX MODEL CACHE
# ==============================================================================
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# UI-only OCR previews (opt-in /v1/doc/ocr/result?include_preview=true).
# Limit total inline image data per response; no preview files are persisted.
UI_PREVIEW_MAX_BYTES=16777216
UI_PREVIEW_MAX_EDGE=2000
