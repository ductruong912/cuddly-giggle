# Server
HOST=127.0.0.1
PORT=8000

# OCR engine selection
OCR_PRIMARY_ENGINE=paddleocr_vl
OCR_FALLBACK_ENGINE=pp_structure_v3
DEFAULT_ENABLE_FALLBACK=false

# PaddleOCR runtime
# Use gpu:0 for first CUDA GPU, cpu for CPU, or leave empty for PaddleOCR default.
OCR_DEVICE=gpu:0
OCR_INFERENCE_ENGINE=

# PaddleOCR-VL pipeline
# Default project target is PaddleOCR-VL 1.6. Set empty to let PaddleOCR choose its package default.
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
WARMUP_MODELS_ON_STARTUP=true

# Local folders
DOC_TEMP_DIR=.tmp_doc_parse
PARSE_OUTPUT_DIR=outputs
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# Optional tuning. Leave these unset/commented to use the built-in defaults
# in app/core/config.py; uncomment a line only to override a specific value.

# Decision thresholds (pass / borderline / quality-fail):
#CONFIDENCE_PASS_THRESHOLD=0.84
#CONFIDENCE_BORDERLINE_THRESHOLD=0.68
#QUALITY_FAIL_THRESHOLD=0.62

# Merge: how much higher the fallback page confidence must be to override the primary page.
#MERGE_FALLBACK_CONFIDENCE_MARGIN=0.08

# Image quality detection (image inputs only; PDFs use a neutral score of 0.9).
# Detection thresholds:
#QUALITY_BLUR_VAR_THRESHOLD=110.0
#QUALITY_DARK_MEAN_THRESHOLD=55.0
#QUALITY_BRIGHT_MEAN_THRESHOLD=220.0
#QUALITY_LOW_CONTRAST_STD_THRESHOLD=24.0
#QUALITY_SKEW_DEG_THRESHOLD=3.0
#QUALITY_MIN_RESOLUTION_PX=1200
#QUALITY_SCREEN_PHOTO_BORDER_DIFF=30.0
# Penalties subtracted from the 1.0 quality score per detected flag:
#QUALITY_PENALTY_SKEW=0.14
#QUALITY_PENALTY_BLUR=0.20
#QUALITY_PENALTY_ILLUMINATION=0.14
#QUALITY_PENALTY_SCREEN_PHOTO=0.18
#QUALITY_PENALTY_LOW_RESOLUTION=0.10

# Optional Qwen verifier
QWEN_VERIFIER_ENABLED=false
QWEN_VERIFIER_BASE_URL=
QWEN_VERIFIER_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_VERIFIER_API_KEY=

# Third-party logging/runtime defaults
QUIET_THIRD_PARTY_LOGS=true
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false
GLOG_minloglevel=2
GLOG_logtostderr=1