# ==============================================================================
# 1. SERVER CONFIGURATION
# ==============================================================================
HOST=127.0.0.1
PORT=8000

# ============================================================================
# 1.1 OPENAI STRUCTURED EXTRACTION (used by /v1/llm/extract)
# ============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_REASONING_EFFORT=low
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_EXTRACT=10/minute

# ==============================================================================
# 1.1b EXTRACTION VALIDATION & SELF-HEALING
# ==============================================================================
# Extra extraction calls allowed when a record fails deterministic validation.
# The failing field and its exact arithmetic are fed back, so a retry is a
# targeted correction rather than a re-roll. 0 disables self-healing.
LLM_SELF_HEAL_MAX_RETRIES=2
# Relative tolerance for quantity x unit_price vs. the line total printed on the
# document. Absorbs display rounding; still catches OCR column shifts.
PO_LINE_TOTAL_TOLERANCE_RATIO=0.01

# ==============================================================================
# 1.2 CONCURRENCY & REQUEST GUARDS
# ==============================================================================
# How many requests may occupy each stage at once. One GPU and a llama.cpp server
# running --parallel 1 serialise recognition, so raising OCR_MAX_CONCURRENCY past
# 2-3 grows the queue without adding throughput. The LLM stage is network-bound
# and tolerates more. Requests that cannot get a slot within the timeout are
# rejected with 503 + Retry-After instead of piling up.
OCR_MAX_CONCURRENCY=2
LLM_MAX_CONCURRENCY=8
STAGE_QUEUE_TIMEOUT_SECONDS=30
# 0 = derive the worker-thread count from the two limits above.
SERVER_THREAD_POOL_SIZE=0

# How long a stage may spend working before the request is failed with 504.
# Without these a wedged backend holds its slot forever, and once every slot is
# held the service refuses all work until it is restarted. Set them above your
# genuine worst-case document, not your average one.
OCR_EXECUTION_TIMEOUT_SECONDS=300
LLM_EXECUTION_TIMEOUT_SECONDS=180
IO_EXECUTION_TIMEOUT_SECONDS=60

# Reject oversized inputs before they occupy an OCR slot.
MAX_UPLOAD_BYTES=52428800
PDF_MAX_PAGES=100

# ==============================================================================
# 1.3 EXTRACTION HISTORY (PostgreSQL)
# ==============================================================================
# Leave DATABASE_URL empty to run file-only, exactly as before. When it is set,
# every extraction is recorded and queryable through /v1/extractions.
# docker compose publishes Postgres on 5433 so it can coexist with a local one.
DATABASE_URL=
# DATABASE_URL=postgresql://docpipe:docpipepass@127.0.0.1:5433/docpipeline
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Server-side cap so a hung query cannot hold an io slot indefinitely.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_MIGRATE_ON_STARTUP=true
# true = a failed write fails the request. A result that was never recorded is
# worse than a retryable error. Set false for best-effort logging.
DATABASE_PERSISTENCE_REQUIRED=true

# ==============================================================================
# 2. OCR ENGINE & RUNTIME CONFIG
# ==============================================================================
OCR_PRIMARY_ENGINE=paddleocr_vl
OCR_DEVICE=gpu:0
WARMUP_MODELS_ON_STARTUP=false

# ==============================================================================
# 3. PADDLEOCR-VL PIPELINE & BACKEND GGUF
# ==============================================================================
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
PADDLEOCR_VL_USE_GGUF=true
PADDLEOCR_VL_REC_BACKEND=llama-cpp-server
PADDLEOCR_VL_REC_SERVER_URL=http://127.0.0.1:8080/v1
PADDLEOCR_VL_REC_MAX_CONCURRENCY=1
PADDLEOCR_VL_REC_API_MODEL_NAME=paddleocr-vl


# ============================================================================
# 3.1 LOCAL CPU OCR (used by /v1/extract/local when no GPU is available)
# ============================================================================
FAST_OCR_DEVICE=cpu
FAST_OCR_DETECTION_MODEL_NAME=PP-OCRv6_medium_det
FAST_OCR_RECOGNITION_MODEL_NAME=PP-OCRv6_small_rec
FAST_OCR_RECOGNITION_BATCH_SIZE=8
FAST_OCR_CPU_THREADS=4
FAST_OCR_INFERENCE_ENGINE=onnxruntime
FAST_OCR_ENABLE_MKLDNN=false

# ============================================================================
# 3.2 ONLINE SURYA OCR (used by /v1/extract/online)
# ============================================================================
DATALAB_API_KEY=
FAST_OCR_DATALAB_MODE=balanced      #fast/balanced/accurate

# ============================================================================== 
# 4. LLAMA.CPP SERVER AUTOSTART
# ==============================================================================
LLAMA_CPP_DIR=llama
LLAMA_CPP_MODELS_DIR=models
LLAMA_SERVER_AUTOSTART=true
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_CTX_SIZE=4096
LLAMA_SERVER_PARALLEL=1
LLAMA_SERVER_N_GPU_LAYERS=20
LLAMA_SERVER_MMPROJ_OFFLOAD=true
LLAMA_SERVER_FLASH_ATTN=on
LLAMA_SERVER_THREADS=4
LLAMA_SERVER_THREADS_BATCH=4
LLAMA_SERVER_TEMP=0
LLAMA_SERVER_LOG_VERBOSITY=1

# ==============================================================================
# 5. DOCUMENT PROCESSING TUNING
# ==============================================================================
PDF_RASTERIZE_ENABLED=true
PDF_RASTERIZE_DPI=200
TABLE_ONLY_OUTPUT=false

# ==============================================================================
# 6. LOCAL DIRECTORIES & PATHS
# ==============================================================================

PARSE_OUTPUT_DIR=outputs
# Saved artifacts are one directory per document and were never cleaned up.
# The sweep runs on a timer, not only at startup, because a healthy service
# rarely restarts. 0 keeps everything forever.
PARSE_OUTPUT_RETENTION_DAYS=14
PARSE_OUTPUT_SWEEP_MINUTES=60
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# ==============================================================================
# 7. NATIVE PARSER THRESHOLDS (CPU FAST-PATH)
# ==============================================================================
PDF_TEXT_PARSE_ENABLED=true
