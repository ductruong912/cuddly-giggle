# ==============================================================================
# 1. SERVER CONFIGURATION
# ==============================================================================
HOST=127.0.0.1
PORT=8000

# ============================================================================
# 1.1 OPENAI STRUCTURED EXTRACTION (used by /v1/llm/extract)
# ============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=120000

# ==============================================================================
# 2. OCR ENGINE & RUNTIME CONFIG
# ==============================================================================
OCR_PRIMARY_ENGINE=paddleocr_vl
OCR_FALLBACK_ENGINE=pp_structure_v3
OCR_DEVICE=gpu:0
OCR_INFERENCE_ENGINE=
WARMUP_MODELS_ON_STARTUP=true

# ==============================================================================
# 3. PADDLEOCR-VL PIPELINE & BACKEND GGUF
# ==============================================================================
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
PADDLEOCR_VL_USE_GGUF=false

PADDLEOCR_VL_REC_BACKEND=llama-cpp-server
PADDLEOCR_VL_REC_SERVER_URL=http://127.0.0.1:8080/v1
PADDLEOCR_VL_REC_MAX_CONCURRENCY=1
PADDLEOCR_VL_REC_API_MODEL_NAME=paddleocr-vl
PADDLEOCR_VL_REC_API_KEY=

# ==============================================================================
# 4. LLAMA.CPP SERVER AUTOSTART
# ==============================================================================
LLAMA_CPP_DIR=llama
LLAMA_CPP_MODELS_DIR=models
LLAMA_CPP_RELEASE_URL=
LLAMA_CPP_RELEASE_FLAVOR=win-cuda-12.4-x64

LLAMA_SERVER_AUTOSTART=true
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_CTX_SIZE=4096
LLAMA_SERVER_PARALLEL=1
LLAMA_SERVER_N_GPU_LAYERS=20
LLAMA_SERVER_MMPROJ_OFFLOAD=true
LLAMA_SERVER_FLASH_ATTN=on
LLAMA_SERVER_THREADS=4
LLAMA_SERVER_THREADS_BATCH=4
LLAMA_SERVER_TEMP=0
LLAMA_SERVER_LOG_VERBOSITY=1
LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=120

# ==============================================================================
# 5. DOCUMENT PROCESSING TUNING
# ==============================================================================
PDF_RASTERIZE_ENABLED=true
PDF_RASTERIZE_DPI=150
TABLE_ONLY_OUTPUT=false

# ==============================================================================
# 6. LOCAL DIRECTORIES & PATHS
# ==============================================================================
DOC_TEMP_DIR=.tmp_doc_parse
PARSE_OUTPUT_DIR=outputs
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# ==============================================================================
# 7. NATIVE PARSER THRESHOLDS (CPU FAST-PATH)
# ==============================================================================
PDF_TEXT_PARSE_ENABLED=true

# ==============================================================================
# 8. NORMALIZER SYNTHETIC HEURISTICS
# ==============================================================================
NORMALIZER_CONFIDENCE_BASE=0.55
NORMALIZER_CONFIDENCE_CONTENT_WEIGHT=0.35
NORMALIZER_CONFIDENCE_TABLE_BONUS=0.05
NORMALIZER_CONFIDENCE_CAP=0.9

# ==============================================================================
# 9. THIRD-PARTY LOGGING & SYSTEM RUNTIME DEFAULT
# ==============================================================================
QUIET_THIRD_PARTY_LOGS=true
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false
GLOG_minloglevel=2
GLOG_logtostderr=1
