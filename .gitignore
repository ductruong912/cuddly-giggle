# ==============================================================================
# 1. PYTHON SYSTEM & RUNTIME CACHES
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
.pyenv/
.pytest_cache/
.pypoetry/

# ==============================================================================
# 2. VIRTUAL ENVIRONMENTS
# ==============================================================================
venv/
.venv/
env/
ENV/

# ==============================================================================
# 3. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ==============================================================================
.env
.env.local
.env.*.local

# ==============================================================================
# 4. APPLICATION TEMPORARY FILES & ARTIFACTS
# ==============================================================================
# Leading "/" anchors these to the repo root. Without it, a pattern like
# "llama/" or "models/" also matches a *source package* of that name at any
# depth (services/llama/, core/models/) and silently drops it from the repo.
/.tmp_doc_parse/
/outputs/
*.log

# ==============================================================================
# 5. LOCAL TEST DATA (GIT-IGNORED FOR PRIVACY)
# ==============================================================================
/data/
/data_test/

# ==============================================================================
# 6. AI MODELS & RUNTIME BINARIES (HEAVY DATA)
# ==============================================================================
/.paddlex/
/.paddleocr/
/llama/
/models/
# `tests/` is deliberately NOT ignored: the suite is part of the repo. `test/`
# stays ignored as a scratch directory.
test/
docs/
.superpowers/
.agents/
AGENTS.md
# Written by `python -m eval.run_eval --json`.
/eval-report.json